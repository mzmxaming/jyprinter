# ---- Python ----
__pycache__/
*.py[cod]

# ---- 虚拟环境（本机构建环境，不入库）----
.venv/
.venv*/
.venv-linux/
.venv-macos/

# ---- 构建产物（由 CI 或本地脚本生成）----
build/
dist/

# ---- 运行时数据（含 secret.key / users.json 等敏感信息，严禁入库）----
# 必须用根目录锚定，否则会连带忽略 Android 源码里的 com/cgm/jyprinter/data/ 包
/data/
/config.json

# ---- 日志 ----
*.log

# ---- Android 工程 ----
android/.gradle/
android/.idea/
android/local.properties
android/.kotlin/
*.iml
*.hprof

# ---- 上游快照目录（另一位开发者的 1.7.1 版本副本，仅作合并来源，不入库）----
/jyprinter/

# ---- iOS 签名凭据（证书 / 描述文件，严禁入库）----
/isocert/
